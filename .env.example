# Salin ke .env lalu isi. Jangan pernah commit file .env.
# `go run` membaca backend/.env atau ../.env; docker compose membaca file ini dari root proyek.
# Variabel environment yang asli selalu menang atas file ini.

APP_ENV=development
HTTP_ADDR=:8080

# Hanya huruf dan angka: nilai ini ikut masuk ke URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://sohopos:GANTI_DENGAN_PASSWORD_POSTGRES@localhost:5432/sohopos?sslmode=disable

# Minimal 32 karakter acak. Di Windows PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Origin frontend yang boleh memanggil API dengan cookie sesi. Pisahkan dengan koma; tiap entri harus
# persis seperti yang tampil di browser: skema + host (+ port), tanpa "/" di akhir, tanpa path, tanpa *.
#   - Lokal lewat proxy Vite (default): kosongkan.
#   - Frontend di Static Site terpisah (Render): isi dengan alamat Static Site, mis. https://chloropos-web.onrender.com
#   - Di belakang reverse proxy yang mengubah header Host: isi dengan alamat yang dibuka di browser.
# ALLOWED_ORIGINS=http://localhost:5173

# Biarkan true. Chrome, Edge, dan Firefox menerima cookie Secure di http://localhost.
# Isi false hanya kalau kasir dibuka lewat http biasa di alamat LAN, atau pasang HTTPS di depannya.
COOKIE_SECURE=true

# SameSite cookie sesi: auto (default), strict, lax, atau none.
#   auto   = Strict, kecuali di APP_ENV=production untuk request dari origin di ALLOWED_ORIGINS yang
#            berbeda dari API: itu mendapat SameSite=None; Secure; Partitioned (frontend dan API di
#            *.onrender.com termasuk situs yang berbeda).
#   lax    = untuk frontend dan API di satu domain induk (app.domain.com + api.domain.com). Paling kompatibel.
#   strict = hanya same-origin.  none = selalu lintas-situs (butuh COOKIE_SECURE=true).
COOKIE_SAMESITE=auto
# Kosongkan (cookie hanya untuk host API, lebih sempit). Isi mis. .domain.com hanya kalau benar-benar perlu.
# COOKIE_DOMAIN=

# Mode API-only (frontend di Static Site terpisah): biarkan STATIC_DIR kosong. Image Dockerfile root mengisinya.
# STATIC_DIR=

# Di production, server mendengarkan di $PORT kalau HTTP_ADDR tidak diisi (Render mengisinya sendiri).

# Zona waktu usaha (nama IANA) untuk "hari ini" di laporan:
# Asia/Jakarta (WIB), Asia/Makassar (WITA), atau Asia/Jayapura (WIT).
REPORT_TZ=Asia/Jakarta

# Membuat admin (perusahaan) kalau belum ada admin. Password minimal 12 karakter.
# Hapus kedua baris ini setelah aplikasi pertama kali berjalan.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
