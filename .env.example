# Copy to .env and fill in. Never commit .env.
# `go run` reads backend/.env or ../.env; docker compose reads this file from the project root.
# Real environment variables always win over this file.

APP_ENV=development
HTTP_ADDR=:8080

# Letters and digits only: this value is embedded in a URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://sohopos:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/sohopos?sslmode=disable

# At least 32 random characters. Windows PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Only needed if a reverse proxy rewrites the Host header. Comma-separated, with scheme and port.
# ALLOWED_ORIGINS=http://localhost:5173

# Keep true. Chrome, Edge and Firefox accept Secure cookies on http://localhost.
# Set false only if the till opens the app over plain http on a LAN address, or put HTTPS in front.
COOKIE_SECURE=true

# Your shop's IANA time zone, used for "today" in reports (for example Europe/London).
REPORT_TZ=UTC

# Creates the first owner when the users table is empty. Password: 12+ characters.
# Remove both lines after the first start.
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=
