# Copy to .env.local. These ship to the browser, so never put secrets here.
VITE_SHOP_NAME=Your Shop
VITE_CURRENCY=USD

# Origin of the API, read at BUILD time. Leave empty (or delete the line) for local development:
# the browser then calls /api on the Vite dev server, which proxies it to localhost:8080.
# Set it when the frontend is a Static Site and the API is another service: scheme://host only,
# no trailing slash, no /api/v1. Changing it needs a new build.
#   VITE_API_BASE=https://chloropos-api.onrender.com
VITE_API_BASE=
